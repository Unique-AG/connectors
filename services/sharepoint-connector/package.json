{
  "name": "@unique-ag/sharepoint-connector",
  "description": "Take content from SharePoint and send it to Unique AI for RAG ingestion..",
  "version": "3.1.1",
  "author": "",
  "private": true,
  "license": "Unique License v1",
  "files": [
    "dist",
    "deploy"
  ],
  "scripts": {
    "build": "nest build",
    "dev": "nest start",
    "debug": "nest start --debug --watch",
    "db:generate": "echo \"No database for this server\"",
    "db:migrate": "echo \"No database for this server\"",
    "db:push": "echo \"No database for this server\"",
    "db:migrate:deploy": "echo \"No database for this server\"",
    "codegen": "echo \"No codegen needed for this server\"",
    "style": "biome check .",
    "style:fix": "biome check . --write",
    "check-types": "tsc --noEmit",
    "check-all": "pnpm style:fix && pnpm check-types",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:e2e:watch": "vitest watch --config vitest.e2e.config.ts",
    "test:coverage": "vitest run --config vitest.coverage.config.ts && istanbul-badges-readme --style='square-flat'"
  },
  "dependencies": {
    "@azure/msal-node": "6.0.0",
    "@microsoft/microsoft-graph-client": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@nestjs/schedule": "catalog:",
    "@nestjs/swagger": "catalog:",
    "@nestjs/terminus": "catalog:",
    "@opentelemetry/api": "catalog:",
    "@proventuslabs/nestjs-zod": "catalog:",
    "@unique-ag/instrumentation": "workspace:*",
    "@unique-ag/logger": "workspace:*",
    "@unique-ag/probe": "workspace:*",
    "bottleneck": "catalog:",
    "cron": "catalog:",
    "graphql": "catalog:",
    "graphql-request": "catalog:",
    "js-yaml": "catalog:",
    "nestjs-otel": "catalog:",
    "nestjs-pino": "catalog:",
    "p-limit": "catalog:",
    "pino": "catalog:",
    "pino-http": "catalog:",
    "reflect-metadata": "catalog:",
    "remeda": "catalog:",
    "rxjs": "catalog:",
    "serialize-error-cjs": "catalog:",
    "undici": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@microsoft/microsoft-graph-types": "2.43.1",
    "@nestjs/cli": "catalog:",
    "@nestjs/schematics": "catalog:",
    "@nestjs/testing": "catalog:",
    "@suites/di.nestjs": "catalog:",
    "@suites/doubles.vitest": "catalog:",
    "@suites/unit": "catalog:",
    "@swc/cli": "catalog:",
    "@swc/core": "catalog:",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "@types/supertest": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "istanbul-badges-readme": "catalog:",
    "supertest": "catalog:",
    "typescript": "catalog:",
    "unplugin-swc": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@10.34.5"
}
