# mcp-scaffold-commit: 5264f9f14505, timestamp: 2026-11-02T00:13:01+00:00
# Bind host/port for the HTTP server. Default: HOST=127.0.0.1, PORT=8000 (loopback only).
# In Kubernetes the chart sets HOST=0.0.0.0 so the pod is reachable from the mesh.
# HOST=127.0.0.1
LOG_LEVEL=INFO
# disclose prints identifying values in logs instead of their sha256. Local debugging only.
LOGS_DIAGNOSTICS_DATA_POLICY=conceal
# Zitadel OIDC — required when serving beyond loopback (UNIQUE_MCP_LOCAL_BASE_URL != 127.0.0.1)
# Public base URL of this service (e.g. https://space-config-mcp.mcp.qa.unique.app)
# UNIQUE_MCP_PUBLIC_BASE_URL=
# Zitadel issuer base URL, e.g. https://id.qa.unique.app
# ZITADEL_BASE_URL=
# Public PKCE client ID registered in Zitadel for this service
# ZITADEL_CLIENT_ID=
# Local signing key for FastMCP's own downstream JWTs (never sent to Zitadel)
# Generate: openssl rand -hex 32
# ZITADEL_JWT_SIGNING_KEY=

# OAuth proxy storage — choose durable (Postgres) or ephemeral (local dev only):
# Durable: set both DATABASE_URL and ENCRYPTION_KEY (openssl rand -hex 32)
# DATABASE_URL=
# ENCRYPTION_KEY=
# Ephemeral (dev/QA): per-pod storage lost on restart — never for prod
# ALLOW_EPHEMERAL_OAUTH_STORAGE=true

# Required: Unique platform credentials
SPACE_CONFIG_MCP_UNIQUE_API_KEY=
SPACE_CONFIG_MCP_UNIQUE_APP_ID=

# Optional: API base URL (defaults to Unique production gateway)
# SPACE_CONFIG_MCP_UNIQUE_API_BASE=https://gateway.unique.app/public/chat-gen2

# Local dev identity fallback (used when _meta auth keys are not injected by the platform)
# UNIQUE_AUTH_USER_ID=
# UNIQUE_AUTH_COMPANY_ID=
# UNIQUE_AUTH_ASSISTANT_ID=

# Required for persistence: scope ID of an existing KB folder where snapshots are stored.
# Set this to the scope ID of your target folder (e.g. skills-conduct or a subfolder).
# The MCP writes directly into this folder — no sub-folders are created.
# Find the ID via the Unique admin portal or: unique-cli kb ls --show-ids
# Without this, snapshot_space still works but snapshots are not persisted.
# SPACE_CONFIG_MCP_KB_SCOPE_ID=

# Tracing is opt-in, e.g. OTEL_TRACES_EXPORTER=console locally or otlp with
# OTEL_EXPORTER_OTLP_ENDPOINT in a cluster.
# OTEL_TRACES_EXPORTER=
