# mcp-scaffold-commit: 5264f9f14505, timestamp: 2026-11-02T00:13:01+00:00
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
# disclose prints identifying values in logs instead of their sha256. Local debugging only.
LOGS_DIAGNOSTICS_DATA_POLICY=conceal
# Public origin, without the MCP path. Defaults to http://HOST:PORT.
# MCP_BASE_URL=http://127.0.0.1:8000
# JSON list of browser origins allowed to call the MCP endpoint.
# MCP_ALLOWED_ORIGINS=["http://localhost:6274"]

# Required: Unique platform credentials
SPACE_CONFIG_MCP_UNIQUE_API_KEY=
SPACE_CONFIG_MCP_UNIQUE_APP_ID=

# Optional: API base URL (defaults to Unique production gateway)
# SPACE_CONFIG_MCP_UNIQUE_API_BASE=https://gateway.unique.app/public/chat-gen2

# Optional: Service-account identity for tool calls (not per-user Zitadel mode)
# SPACE_CONFIG_MCP_SERVICE_USER_ID=
# SPACE_CONFIG_MCP_SERVICE_COMPANY_ID=

# Optional: Path for the JSON snapshot store (defaults to /tmp)
# SPACE_CONFIG_MCP_SNAPSHOT_STORE_PATH=/tmp/space-config-snapshots.json

# Tracing is opt-in, e.g. OTEL_TRACES_EXPORTER=console locally or otlp with
# OTEL_EXPORTER_OTLP_ENDPOINT in a cluster.
# OTEL_TRACES_EXPORTER=
