[
  {
    "method": "POST",
    "path": "/v1.0/me/messages",
    "json": {
      "@odata.type": "#microsoft.graph.message",
      "body": {
        "content": "request for the contract by Friday",
        "contentType": "html"
      },
      "ccRecipients": [],
      "subject": "Contract",
      "toRecipients": [
        {
          "emailAddress": {
            "address": "anna.meier@example.com"
          }
        }
      ]
