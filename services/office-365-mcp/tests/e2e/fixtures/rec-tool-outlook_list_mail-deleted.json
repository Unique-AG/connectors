[
  {
    "method": "GET",
    "path": "/v1.0/me/mailFolders/deleteditems",
    "query": {
      "$select": "displayName,totalItemCount,unreadItemCount"
    },
    "status": 200,
    "response_headers": {
      "content-type": "application/json; odata.metadata=minimal; odata.streaming=true; IEEE754Compatible=false; charset=utf-8"
    },
    "body": "rec-tool-outlook_list_mail-deleted.01.json"
  },
  {
    "method": "GET",
    "path": "/v1.0/me/mailFolders/deleteditems/messages",
    "headers": {
      "prefer": "IdType=\"ImmutableId\""
    },
    "query": {
      "$orderby": "receivedDateTime desc",
      "$select": "id,subject,bodyPreview,from,toRecipients,receivedDateTime,isRead,hasAttachments,parentFolderId,webLink,importance,flag,categories,isDraft,sender,replyTo",
      "$top": "5"
    },
    "status": 200,
    "response_headers": {
      "content-type": "application/json; odata.metadata=minimal; odata.streaming=true; IEEE754Compatible=false; charset=utf-8",
      "preference-applied": "IdType=ImmutableId"
    },
    "body": "rec-tool-outlook_list_mail-deleted.02.json"
  }
]
