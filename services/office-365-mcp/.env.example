# Application environment: development | production | test
APP_ENV=development

# Port the HTTP server listens on
PORT=9544

# Log level: critical | error | warning | info | debug
LOG_LEVEL=info

# The externally-reachable URL of this service — the OAuth issuer/base URL. With
# APP_ENV=production a loopback or 0.0.0.0 URL is rejected at startup: left at the local default,
# clients would be redirected to a login form on their own machine and simply fail to connect.
# APP_ENV=production also requires https: the OAuth endpoints are published under this URL.
# The Entra app registration must list "$PUBLIC_BASE_URL/auth/callback" as a Web redirect URI.
PUBLIC_BASE_URL=http://localhost:9544

# Which tools this deployment runs, and so which delegated Graph permissions every user is asked to
# consent to at sign-in. Set exactly ONE of the two: both set is a startup error, and so is neither,
# because there is deliberately no default — "every tool" would otherwise be what an operator gets
# by not choosing. Narrowing later is free; widening adds a permission to the authorize request, so
# every signed-in user has to sign in again before the new tool works.
# TOOLS_PRESET is a named surface. teams is every Teams tool; the rest are one use case each —
# teams-chat, teams-messages, teams-channels, teams-transcripts, teams-recordings, teams-meetings,
# and for Outlook two independent axes: outlook-read, outlook-write, outlook-send for mail
# content, and outlook-mailbox, outlook-automate for mailbox configuration. Neither axis asks
# for the other's permissions. README's table says what each costs a
# tenant in permissions and consents, and which of them can change or send mail.
# TOOLS_ENABLED is a comma-separated list of tool names; get_me is always on, so it need not be
# listed, which is why no deployment asks for fewer permissions than User.Read. GET /manifest and
# the startup log print the tools, the exact permissions and which of them need admin consent.
TOOLS_PRESET=teams
# TOOLS_ENABLED=get_me

# The Entra app registration users sign in through. All three are required — the service does not
# start without them. TENANT_ID is one tenant's ID, or "organizations" for a multi-tenant
# registration (AzureADMultipleOrgs): then any Entra tenant's users can sign in, each token is
# validated against its own tenant's issuer, and Graph is called in that tenant. "common" and
# "consumers" are rejected: personal Microsoft accounts have no Microsoft 365 mailbox or Teams.
# The app registration must also expose an API with the scope "access_as_user" (see README).
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# How long one Microsoft Graph call may take, and how hard the SDK retries it. All three are
# optional; the defaults below are what the service uses when they are unset, and they are sized for
# an interactive MCP client rather than for a batch job.
# What you are really turning is the worst case of one tool call: the request timeout times
# GRAPH_MAX_RETRIES + 1 attempts, before any Retry-After wait, per Graph call — and a paged walk
# makes several. Raising either past what the client on the other end waits for buys a slower
# failure and nothing else.
# GRAPH_MAX_RETRIES=0 is a real choice: it gives up on the first 429 rather than waiting out the
# Retry-After. A timeout of 0 is refused, because httpx reads a timeout as a deadline and not as
# "unbounded".
# GRAPH_REQUEST_TIMEOUT_SECONDS=30
# GRAPH_CONNECT_TIMEOUT_SECONDS=10
# GRAPH_MAX_RETRIES=3

# Database - either DB_URL / DATABASE_URL or all individual settings.
# DATABASE_URL is also accepted (injected by the base Helm chart when postgresql.enabled).
# A plain postgresql:// URL is what asyncpg wants. A postgresql+asyncpg:// or postgres:// URL
# is accepted and normalised: sslmode=verify becomes verify-full, channel_binding is dropped.
# DB_URL=postgresql://postgres:postgres@localhost:9001/office_365_mcp
DB_HOST=localhost
DB_PORT=9001
DB_NAME=office_365_mcp
DB_USER=postgres
DB_PASSWORD=postgres

# Tracing, off unless one of these is set — `configure_tracing` installs no tracer provider without
# them and every span in the process stays a no-op. All commented out on purpose: a developer who
# wants traces opts in, and a test run must not.
# OTEL_SERVICE_NAME and OTEL_SERVICE_VERSION are absent because create_app passes both explicitly.
#
# Print spans to stderr, which needs no collector:
# OTEL_TRACES_EXPORTER=console
#
# Or send them to a collector. Either endpoint turns tracing on by itself, so OTEL_TRACES_EXPORTER
# need not also be set; the traces-specific one wins where both are, and is taken verbatim, while
# the generic one gets "/v1/traces" appended. The exporter speaks OTLP over HTTP, hence 4318.
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
#
# Which environment the spans came from. Nothing else sets it: configure_tracing writes service.name
# and service.version and stops there.
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment=development
