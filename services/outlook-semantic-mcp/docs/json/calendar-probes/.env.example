# Copy to .env in this folder. Never commit it.
# Access token is enough for GET probes. Refresh is used only when Graph returns 401.
#
# Tokens copied from user_profiles are AES-256-GCM (iv.tag.data). The probe decrypts
# them with ENCRYPTION_KEY from services/outlook-semantic-mcp/.env.
GRAPH_ACCESS_TOKEN=
GRAPH_REFRESH_TOKEN=

# Optional if not already in services/outlook-semantic-mcp/.env
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=common
