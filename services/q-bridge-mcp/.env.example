# Bind address and port for the remote-only MCP server.
HOST=0.0.0.0
PORT=8000
PYTHON_ENV=development

# Public URL of this service. Register ${MCP_BASE_URL}/auth/callback in Zitadel.
MCP_BASE_URL=http://localhost:8000

# Use a stable, high-entropy value in deployed environments.
MCP_JWT_SIGNING_KEY=replace-with-a-random-secret-at-least-32-characters

# Generate with Fernet.generate_key(); the file-backed store is encrypted.
# Generate with: uv run python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
STORAGE_ENCRYPTION_KEY=<generated-fernet-key>

# Unique environment shared by every configured organization.
UNIQUE_API_BASE_URL=https://gateway.unique.app/public/chat-gen2

# Zitadel issuer base URL; discovery is resolved automatically.
ZITADEL_ISSUER_URL=https://your-instance.zitadel.cloud
ZITADEL_CLIENT_ID=your-zitadel-client-id
ZITADEL_CLIENT_SECRET=your-zitadel-client-secret

# Production storage:
# PYTHON_ENV=production
# REDIS_HOST=redis.example.com
# REDIS_PORT=6379
# REDIS_DATABASE=0
# REDIS_PASSWORD=your-redis-password
# REDIS_SSL=true
