# Fixed test environment — committed, never the developer's real .env.
# conftest.py points Settings at this file for every test, so a real
# DATABASE_URL/ENCRYPTION_KEY (added locally for manual Postgres testing)
# can never leak into test runs.
ZITADEL_BASE_URL=https://id.test.unique.app
ZITADEL_CLIENT_ID=test-client-id
ALLOW_EPHEMERAL_OAUTH_STORAGE=true
