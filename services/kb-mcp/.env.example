# kb-mcp local config.
# cp .env.example .env  — then fill in values.
# Replace <tenant> with your Unique tenant slug (e.g. your company env name).
# A single .env is enough: main() loads it into the process env (so
# unique-toolkit / logging / tracing see it too), and process env vars still
# win over anything set here.

# ==== Logging (unique-mcp configure_logging → pino-json on stderr) ====
# Levels: DEBUG / INFO / WARNING / ERROR / CRITICAL (default INFO).
# Deploy pods set logging.unique.app/format=pino-json for Loki.
LOG_LEVEL=info

# ==== MCP server (unique-mcp) ====
# Both required. OAuth / Host allowlist use PUBLIC when set, else LOCAL
# (unique-mcp: base_url = public_base_url or local_base_url).
# LOCAL = bind address. PUBLIC = URL clients hit (same as LOCAL for pure
# localhost; ngrok/ingress URL when tunneling or deploying).
UNIQUE_MCP_LOCAL_BASE_URL=http://127.0.0.1:8003
UNIQUE_MCP_PUBLIC_BASE_URL=http://127.0.0.1:8003
# Deploy / tunnel example:
# UNIQUE_MCP_PUBLIC_BASE_URL=https://kb-mcp.<tenant>.unique.app

# Optional Unique web app origin for knowledge-upload citation deep links.
# UNIQUE_MCP_FRONTEND_BASE_URL=https://<tenant>.unique.app

# ==== Unique API (unique-toolkit) ====
UNIQUE_APP_KEY=
UNIQUE_APP_ID=
UNIQUE_API_BASE_URL=https://gateway.<tenant>.unique.app
UNIQUE_APP_ENDPOINT=
UNIQUE_APP_ENDPOINT_SECRET=

# Local unauthenticated-dev only. Do NOT set these in deployed environments —
# identity there comes from OIDC / Unique AI _meta.
UNIQUE_AUTH_COMPANY_ID=
UNIQUE_AUTH_USER_ID=

# ==== OpenTelemetry (unique-toolkit configure_tracing) ====
# Opt-in. Unset / none in prod unless OTLP is wired.
OTEL_SERVICE_NAME=kb-mcp
OTEL_TRACES_EXPORTER=console
# Deploy example:
# OTEL_TRACES_EXPORTER=otlp
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# ==== Zitadel OIDC (unique-mcp auth) ====
ZITADEL_BASE_URL=https://id.<tenant>.unique.app
ZITADEL_CLIENT_ID=
ZITADEL_CLIENT_SECRET=

# ==== OAuth proxy storage (client registrations, tokens, JTI mappings) ====
# Required in every deployed environment — without it, every pod restart or
# extra replica logs out all users. Set both, or opt into the ephemeral local
# dev store below.
# DATABASE_URL=postgresql://user:pass@localhost:5432/kb_mcp
# Generate with: openssl rand -hex 32
# ENCRYPTION_KEY=

# Local dev only — never set this in a deployed environment. Falls back to an
# encrypted on-disk store under the OS temp dir; sessions do not survive a
# restart and are not shared across processes.
# ALLOW_EPHEMERAL_OAUTH_STORAGE=true
