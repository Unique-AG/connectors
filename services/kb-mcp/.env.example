# kb-mcp local config.
# Copy this file to .env and fill in the values.
# Replace <tenant> with your Unique tenant slug.
# Environment variables override values from this file.

# ==== Logging (unique-mcp configure_logging → pino-json on stderr) ====
# Levels: DEBUG, INFO, WARNING, ERROR, or CRITICAL.
# Deploy pods set logging.unique.app/format=pino-json for Loki.
LOG_LEVEL=info

# ==== MCP server (unique-mcp) ====
# LOCAL is the bind address. PUBLIC is the URL used by MCP clients and OAuth.
# PUBLIC may match LOCAL for localhost development.
UNIQUE_MCP_LOCAL_BASE_URL=http://127.0.0.1:8003
UNIQUE_MCP_PUBLIC_BASE_URL=http://127.0.0.1:8003
# UNIQUE_MCP_PUBLIC_BASE_URL=https://kb-mcp.<tenant>.unique.app

# Optional web app origin for knowledge-upload citation links.
# UNIQUE_MCP_FRONTEND_BASE_URL=https://<tenant>.unique.app

# ==== Unique API (unique-toolkit) ====
# Use the internal service URL in Kubernetes; use the gateway URL locally or
# when this service is intentionally routed through Kong.
UNIQUE_API_BASE_URL=https://gateway.<tenant>.unique.app
# Required for local development and Kong/public-gateway deployments.
UNIQUE_APP_KEY=
UNIQUE_APP_ID=

# Local unauthenticated development only. Deployed identity comes from OIDC.
UNIQUE_AUTH_COMPANY_ID=
UNIQUE_AUTH_USER_ID=

# ==== OpenTelemetry (unique-toolkit configure_tracing) ====
# Opt-in. Unset / none in prod unless OTLP is wired.
OTEL_SERVICE_NAME=kb-mcp
OTEL_TRACES_EXPORTER=console
# Deploy example:
# OTEL_TRACES_EXPORTER=otlp
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# ==== Zitadel OIDC (unique-mcp auth) ====
# Public client; PKCE means no client secret is required.
ZITADEL_BASE_URL=https://id.<tenant>.unique.app
ZITADEL_CLIENT_ID=
# Local secret FastMCP uses to sign its own downstream JWTs (never sent to Zitadel).
# Generate with: openssl rand -hex 32
ZITADEL_JWT_SIGNING_KEY=

# ==== OAuth proxy storage (client registrations, tokens, JTI mappings) ====
# Production: set both values so sessions survive restarts and replicas.
# DATABASE_URL=postgresql://user:pass@localhost:5432/kb_mcp
# Generate with: openssl rand -hex 32
# ENCRYPTION_KEY=

# Local development only: use the encrypted per-process file store.
# ALLOW_EPHEMERAL_OAUTH_STORAGE=true

# ==== MCP tools ====
# Unset = all tools. Search-only example:
# KB_MCP_ENABLED_TOOLS=search,read_file

# Optional search tuning.
# KB_MCP_SEARCH_SCOPE_LOOKUP_CONCURRENCY=8

# Optional outbound HTTP pool tuning.
# KB_MCP_HTTP_MAX_CONNECTIONS=100
# KB_MCP_HTTP_MAX_KEEPALIVE_CONNECTIONS=20
# KB_MCP_HTTP_POOL_TIMEOUT_SECONDS=60

# Optional content_tree cache tuning.
# KB_MCP_CONTENT_TREE_CACHE_TTL_SECONDS=600
# KB_MCP_CONTENT_TREE_CACHE_MAX_ENTRIES=24

# Optional content_tree wait tuning. The default cannot exceed the maximum.
# KB_MCP_CONTENT_TREE_TIMEOUT_SECONDS=30
# KB_MCP_CONTENT_TREE_MAX_TIMEOUT_SECONDS=45

# Docker/Linux only: periodic glibc RSS trimming.
MEMORY_TRIM_INTERVAL_SECONDS=30
