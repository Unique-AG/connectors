HOST=127.0.0.1
PORT=9542
LOG_LEVEL=INFO
# Public origin, without the MCP path. Defaults to http://HOST:PORT.
# MCP_BASE_URL=http://127.0.0.1:9542
# JSON list of browser origins allowed to call the MCP endpoint.
# MCP_ALLOWED_ORIGINS=["http://localhost:6274"]

# The MCP endpoint is mounted at /<MCP_API_KEY>/mcp.
MCP_API_KEY=

# Kyckr credentials and environment.
KYCKR_API_KEY=
KYCKR_API_URL=https://test-api.kyckr.com/v2
KYCKR_TIMEOUT_SECONDS=30

# Optional values forwarded to Kyckr paid calls.
KYCKR_DEFAULT_CUSTOMER_REFERENCE=
KYCKR_DEFAULT_CONTACT_EMAIL=

# Tracing is opt-in, e.g. OTEL_TRACES_EXPORTER=console locally or otlp with
# OTEL_EXPORTER_OTLP_ENDPOINT in a cluster.
# OTEL_TRACES_EXPORTER=
