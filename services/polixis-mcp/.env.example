# mcp-scaffold-commit: f07e25a209f4, timestamp: 2026-11-09T11:34:03+00:00
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
# disclose prints identifying values in logs instead of their sha256. Local debugging only.
LOGS_DIAGNOSTICS_DATA_POLICY=conceal
# Public origin, without the MCP path. Defaults to http://HOST:PORT.
# MCP_BASE_URL=http://127.0.0.1:8000
# JSON list of browser origins allowed to call the MCP endpoint.
# MCP_ALLOWED_ORIGINS=["http://localhost:6274"]

# none serves without sign-in, on loopback only. zitadel is what a deployment uses.
MCP_AUTH_MODE=none
# ZITADEL_BASE_URL=https://zitadel.example.com
# ZITADEL_CLIENT_ID=
# Leave unset for a public client with PKCE.
# ZITADEL_CLIENT_SECRET=
# At least 32 characters. Signs the tokens the MCP issues and encrypts them in Postgres.
# ZITADEL_JWT_SIGNING_KEY=
# Restricts sign-in to one organisation.
# ZITADEL_ORG_ID=

# Polixis client credentials, exchanged for a bearer token at UPSTREAM_TOKEN_URL, and the API
# key sent as `x-api-key` beside it. Polixis sends both in its credentials email.
UPSTREAM_CLIENT_ID=
UPSTREAM_CLIENT_SECRET=
UPSTREAM_API_KEY=
UPSTREAM_API_URL=https://api-polixis.polixis.com
UPSTREAM_TOKEN_URL=https://auth.polixis.com/realms/plx-prod/protocol/openid-connect/token
UPSTREAM_TIMEOUT_SECONDS=30
# UPSTREAM_RETRY_MAX_ATTEMPTS=5
# UPSTREAM_RETRY_MAX_WAIT_SECONDS=30
# UPSTREAM_MAX_CONCURRENT_REQUESTS=4
# UPSTREAM_QUOTA_COOLDOWN_SECONDS=900

# The chart sets DATABASE_URL, PG_DATABASE_SSL_MODE and DB_SSL_ROOT_CERT.
DATABASE_URL=postgresql://dummy-user:dummy-password@localhost:5432/polixis_mcp

# Tracing is opt-in, e.g. OTEL_TRACES_EXPORTER=console locally or otlp with
# OTEL_EXPORTER_OTLP_ENDPOINT in a cluster.
# OTEL_TRACES_EXPORTER=

# Record or replay Polixis answers locally: off, record or replay. Never in a deployment.
# UPSTREAM_RECORDING_MODE=off
# UPSTREAM_RECORDING_BUDGET=
