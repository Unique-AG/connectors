    "description": "Find organizations and people in Polixis by name or identifier, with their sanctions and\nPEP flags.\n\nCall it first: every other Polixis tool takes a match's `pid` as its `id`, such as\n`get_corporate_profile`, `get_ultimate_beneficial_owners` or `get_smart_graph`.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "countries": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ISO 3166-1 alpha-2 country codes, such as `ch`. A match needs only one of them."
        },
        "entity_type": {
          "anyOf": [
            {
              "enum": [
                "ORGANIZATION",
                "PERSON"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Only organizations or only people. Leave it out for both."
        },
        "name": {
          "description": "A name, registration number, LEI or ISIN of an organization or person.",
          "minLength": 1,
          "type": "string"
        },
        "page": {
          "default": 1,
          "description": "The page to return, from 1.",
          "minimum": 1,
          "type": "integer"
        },
        "page_size": {
          "default": 10,
          "description": "Matches per page.",
          "maximum": 50,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "name": "search_entities",
    "outputSchema": {
      "description": "One page of matches, best first: exact matches, then fuzzy ones.",
      "properties": {
        "matches": {
          "description": "The matches on this page.",
          "items": {
            "description": "An organization or person the search matched.",
            "properties": {
              "alerts": {
                "description": "Risk and status alerts, as Polixis words them.",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "entity_type": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "PERSON or ORGANIZATION; vessels and aircraft are organizations."
              },
              "identifiers": {
                "additionalProperties": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "description": "Identifiers by type, such as registration numbers, LEIs or tax ids.",
                "type": "object"
              },
              "names": {
                "description": "Its names, aliases and original-language spellings.",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "pid": {
                "description": "Polixis' permanent id, which every other Polixis tool takes as `id`.",
                "type": "string"
              },
