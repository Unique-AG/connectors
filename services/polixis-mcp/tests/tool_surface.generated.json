  {
    "annotations": {
      "openWorldHint": true,
      "readOnlyHint": true
    },
    "description": "Walks the relationship network out from an entity up to `radius` hops. Leaves out signatory, third-party and historic relations, and returns names and images for each node in `meta` besides any `fields` requested.\n",
    "inputSchema": {
      "properties": {
        "fields": {
          "description": "Profile fields to return for each node in `meta`.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "filter": {
          "properties": {
            "rules": {
              "additionalProperties": {
                "properties": {
                  "allowedCtg": {
                    "description": "Comma-separated relation categories to follow; empty follows all.",
                    "type": "string"
                  },
                  "direction": {
                    "enum": [
                      "IN",
                      "OUT",
                      "BOTH"
                    ],
                    "type": "string"
                  },
                  "excludedCtg": {
                    "description": "Comma-separated relation categories not to follow.",
                    "type": "string"
                  },
                  "onlyActual": {
                    "type": "boolean"
                  },
                  "requireOrg": {
                    "type": "boolean"
                  },
                  "requirePerson": {
                    "type": "boolean"
                  },
                  "requireSanction": {
                    "type": "boolean"
                  },
                  "requireSoe": {
                    "type": "boolean"
                  }
                },
                "type": "object"
              },
              "description": "One rule per relation type to follow, keyed by the relation type. Relation types without a rule are not followed. Without a filter the default rules apply.\n",
              "type": "object"
            }
          },
          "type": "object"
        },
        "id": {
          "description": "The entity the walk starts from.",
          "type": "string"
        },
        "radius": {
          "description": "How many hops to walk out from the entity.",
          "type": "integer"
        },
        "truncate": {
          "description": "Return a reduced graph, recommended for large ones.",
          "type": "boolean"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "name": "get_smart_graph",
