{
  "name": "@unique-ag/confluence-connector",
  "description": "Take content from Confluence and send it to Unique AI for RAG ingestion.",
  "version": "3.0.2",
  "author": "",
  "private": true,
  "license": "Unique License v1",
  "files": [
    "dist",
    "deploy"
  ],
  "scripts": {
    "build": "nest build",
    "dev": "nest start",
    "debug": "nest start --debug --watch",
    "db:generate": "echo \"No database for this server\"",
    "db:migrate": "echo \"No database for this server\"",
    "db:push": "echo \"No database for this server\"",
    "db:migrate:deploy": "echo \"No database for this server\"",
    "codegen": "echo \"No codegen needed for this server\"",
    "style": "biome check .",
    "style:fix": "biome check . --write",
    "check-types": "tsc --noEmit",
    "check-all": "pnpm style:fix && pnpm check-types",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:watch": "vitest watch --config vitest.integration.config.ts",
    "test:coverage": "vitest run --config vitest.coverage.config.ts && istanbul-badges-readme --style='square-flat'"
  },
  "dependencies": {
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@nestjs/schedule": "catalog:",
    "@nestjs/swagger": "catalog:",
    "@nestjs/terminus": "catalog:",
    "@opentelemetry/api": "catalog:",
    "@proventuslabs/nestjs-zod": "catalog:",
    "@unique-ag/instrumentation": "workspace:*",
    "@unique-ag/logger": "workspace:*",
    "@unique-ag/probe": "workspace:*",
    "@unique-ag/unique-api": "workspace:*",
    "@unique-ag/utils": "workspace:*",
    "bottleneck": "catalog:",
    "cron": "catalog:",
    "htmlparser2": "12.0.0",
    "js-yaml": "catalog:",
    "nestjs-otel": "catalog:",
    "nestjs-pino": "catalog:",
    "p-limit": "catalog:",
    "pino": "catalog:",
    "pino-http": "catalog:",
    "reflect-metadata": "catalog:",
    "remeda": "catalog:",
    "rxjs": "catalog:",
    "typeid-js": "catalog:",
    "undici": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@golevelup/ts-vitest": "4.0.0",
    "@nestjs/cli": "catalog:",
    "@nestjs/schematics": "catalog:",
    "@nestjs/testing": "catalog:",
    "@suites/di.nestjs": "catalog:",
    "@suites/doubles.vitest": "catalog:",
    "@suites/unit": "catalog:",
    "@swc/cli": "catalog:",
    "@swc/core": "catalog:",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "@types/supertest": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "domhandler": "6.0.1",
    "istanbul-badges-readme": "catalog:",
    "supertest": "catalog:",
    "typescript": "catalog:",
    "unplugin-swc": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@10.34.5"
}
