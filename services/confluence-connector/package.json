{
  "name": "@unique-ag/confluence-connector",
  "description": "Take content from Confluence and send it to Unique AI for RAG ingestion.",
  "version": "3.0.1",
  "author": "",
  "private": true,
  "license": "Unique License v1",
  "files": [
    "dist",
    "deploy"
  ],
  "scripts": {
    "build": "nest build",
    "dev": "nest start",
    "debug": "nest start --debug --watch",
    "db:generate": "echo \"No database for this server\"",
    "db:migrate": "echo \"No database for this server\"",
    "db:push": "echo \"No database for this server\"",
    "db:migrate:deploy": "echo \"No database for this server\"",
    "codegen": "echo \"No codegen needed for this server\"",
    "style": "biome check .",
    "style:fix": "biome check . --write",
    "check-types": "tsc --noEmit",
    "check-all": "pnpm style:fix && pnpm check-types",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:watch": "vitest watch --config vitest.integration.config.ts",
    "test:coverage": "vitest run --config vitest.coverage.config.ts && istanbul-badges-readme --style='square-flat'"
  },
  "dependencies": {
    "@nestjs/common": "12.0.1",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "@nestjs/schedule": "12.0.1",
    "@nestjs/terminus": "12.0.0",
    "@opentelemetry/api": "1.9.1",
    "@proventuslabs/nestjs-zod": "2.0.0",
    "@unique-ag/instrumentation": "workspace:*",
    "@unique-ag/logger": "workspace:*",
    "@unique-ag/probe": "workspace:*",
    "@unique-ag/unique-api": "workspace:*",
    "@unique-ag/utils": "workspace:*",
    "bottleneck": "2.19.5",
    "cron": "4.4.0",
    "domhandler": "6.0.1",
    "htmlparser2": "12.0.0",
    "js-yaml": "5.4.1",
    "nestjs-otel": "8.1.0",
    "nestjs-pino": "5.0.0",
    "p-limit": "7.3.1",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "remeda": "2.45.0",
    "rxjs": "7.8.2",
    "serialize-error-cjs": "0.2.0",
    "typeid-js": "1.2.0",
    "undici": "8.10.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@golevelup/ts-vitest": "4.0.0",
    "@nestjs/cli": "12.0.0",
    "@nestjs/schematics": "12.0.0",
    "@nestjs/testing": "12.0.1",
    "@suites/di.nestjs": "3.1.0",
    "@suites/doubles.vitest": "3.1.0",
    "@suites/unit": "3.1.1",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.16.1",
    "@types/express": "5.0.6",
    "@types/js-yaml": "4.0.9",
    "@types/node": "26.4.0",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-istanbul": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "globals": "17.11.0",
    "istanbul-badges-readme": "1.9.0",
    "pino-http-print": "4.0.0",
    "source-map-support": "0.5.21",
    "supertest": "7.2.2",
    "typescript": "7.0.2",
    "unplugin-swc": "1.5.11",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@10.34.5"
}
