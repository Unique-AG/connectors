# QCC gateway credentials. Copy to `.env` (gitignored) and fill in.
# Sandbox keys are prefixed `sbox-` and return mock data for fixture entities only.
# Production keys return real company & person data (PII).
QCC_API_KEY=sbox-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
QCC_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional overrides:
# QCC_BASE_URL=https://gateway.qcckyc.com/api/external/customer
# QCC_TIMEOUT_S=30

# Serve over HTTP instead of stdio:
# QCC_MCP_HTTP=1
# QCC_MCP_HOST=127.0.0.1
# QCC_MCP_PORT=8000
