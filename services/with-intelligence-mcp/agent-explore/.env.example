# Copy to .env in this directory. Do not commit .env.
# Used by explore.py only. Never print these values.
#
# The credentials are what `POST /v3/auth/sign-in` accepts: the username With Intelligence
# provisioned, and the permanent password set through `POST /v3/auth/set-password` using the
# one-time passcode from their onboarding mail. Unique's trial account is
# team-data-flow@unique.ch.
#
# spec.py needs none of this — the OpenAPI spec is public.

WITH_INTELLIGENCE_BASE_URL=https://api.withintelligence.com
WITH_INTELLIGENCE_USERNAME=
WITH_INTELLIGENCE_PASSWORD=
