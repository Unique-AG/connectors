# Application environment: development | production | test
APP_ENV=development

# Port the HTTP server listens on
PORT=9011

# Log level: critical | error | warning | info | debug
LOG_LEVEL=info

# The externally-reachable URL of this service. With Intelligence has no OAuth, so this service
# is the OAuth issuer for its MCP clients: discovery metadata, /authorize, /token and the login
# form all hang off this. With APP_ENV=production a loopback or 0.0.0.0 URL is rejected at
# startup — left at the local default, clients would be redirected to a login form on their own
# machine and simply fail to connect.
PUBLIC_BASE_URL=http://localhost:9011

# With Intelligence v3 REST API base URL.
# Docs: https://withapi.readme.io/docs/getting-started
# Spec: https://api.withintelligence.com/v3/docs/json
WITH_INTELLIGENCE_BASE_URL=https://api.withintelligence.com

# Which asset-class packages ("data solutions") tool calls ask for, as accepted by the
# `asset_class_group` query parameter on every core endpoint. Valid values: hfm, pefi, pcfi,
# refi, cwi, iwi, sfo. Responses are auto-filtered to what the account is licensed for whatever
# is set here — Unique's agreement covers With HFM (hedge funds) and With SFO (wealth / family
# office) — but asking narrowly keeps a hedge-fund question from paging through wealth records
# to find its answer. v1 scope is hedge fund content, so this defaults to hfm alone.
# WITH_INTELLIGENCE_ASSET_CLASS_GROUPS=["hfm","sfo"]

# Per-request timeout against the vendor API.
# WITH_INTELLIGENCE_DEFAULT_TIMEOUT_SECONDS=30

# Page size for listing endpoints. Every one of them pages identically (`page`, `page_size`,
# and a `{pagination:{page,page_size,count,total}, results:[...]}` envelope).
# WITH_INTELLIGENCE_DEFAULT_PAGE_SIZE=50

# How many requests one user may have in flight. With Intelligence publishes no concurrency
# limit — unlike Backstop's hard 5-per-user cap this is our own politeness bound until a
# measured one replaces it. Every documented path can answer 429.
# WITH_INTELLIGENCE_MAX_CONCURRENT_REQUESTS_PER_USER=5

# Retry budget for a rate-limited or transient upstream failure.
# WITH_INTELLIGENCE_MAX_RETRY_ATTEMPTS=3
# WITH_INTELLIGENCE_MAX_RETRY_WAIT_MS=8000

# No *per-user* With Intelligence credentials are configured as env vars: each MCP client will
# go through this service's own OAuth login (a form collecting the username and password their
# `POST /v3/auth/sign-in` accepts), and the resulting session — a 1-hour access token over a
# 30-day refresh token — is stored encrypted per user rather than shared across all callers.
# The one-time passcode in the vendor's onboarding mail belongs to `POST /v3/auth/set-password`
# and is completed by the user before they ever reach this service.

# Database - either DB_URL / DATABASE_URL or all individual settings.
# DATABASE_URL is also accepted (injected by the base Helm chart when postgresql.enabled).
# A plain "postgresql://" URL works too — DatabaseConfig rewrites it to
# "postgresql+asyncpg://" automatically, so you don't need to add the driver yourself.
# DB_URL=postgresql://postgres:postgres@localhost:9001/with_intelligence_mcp
DB_HOST=localhost
DB_PORT=9001
DB_NAME=with_intelligence_mcp
DB_USER=postgres
DB_PASSWORD=postgres
