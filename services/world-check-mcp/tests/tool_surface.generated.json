                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            }
          },
          "required": [
            "id",
            "label"
          ],
          "type": "object"
        },
        "ResolutionToolkit": {
          "properties": {
            "provider_type": {
              "type": "string"
            },
            "reasons": {
              "items": {
                "$ref": "#/$defs/ResolutionOption"
              },
              "type": "array"
            },
            "risks": {
