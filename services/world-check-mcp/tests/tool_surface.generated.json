            },
            "required": {
              "type": "boolean"
            },
            "type_id": {
              "type": "string"
            },
            "value_type": {
              "type": "string"
            }
          },
          "required": [
            "provider",
            "entity_type",
            "type_id",
            "label",
            "value_type",
            "required"
          ],
          "type": "object"
        }
      },
      "properties": {
        "group": {
          "$ref": "#/$defs/Group"
        },
        "mandatory_provider_types": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "screening_type": {
          "type": "string"
        },
        "secondary_fields": {
          "items": {
            "$ref": "#/$defs/SecondaryField"
          },
          "type": "array"
        },
        "toolkits": {
          "items": {
            "$ref": "#/$defs/ResolutionToolkit"
          },
          "type": "array"
