# mcp-scaffold-version: 0.0.1, timestamp: 2026-10-22T06:27:45+00:00
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
# disclose prints identifying values in logs instead of their sha256. Local debugging only.
LOGS_DIAGNOSTICS_DATA_POLICY=conceal
# Public origin, without the MCP path. Defaults to http://HOST:PORT.
# MCP_BASE_URL=http://127.0.0.1:8000
# JSON list of browser origins allowed to call the MCP endpoint.
# MCP_ALLOWED_ORIGINS=["http://localhost:6274"]

# none serves without sign-in, on loopback only. zitadel is what a deployment uses.
MCP_AUTH_MODE=none
# ZITADEL_BASE_URL=https://zitadel.example.com
# ZITADEL_CLIENT_ID=
# Leave unset for a public client with PKCE.
# ZITADEL_CLIENT_SECRET=
# At least 32 characters. Signs the tokens the MCP issues and encrypts them in Redis.
# ZITADEL_JWT_SIGNING_KEY=
# Restricts sign-in to one organisation.
# ZITADEL_ORG_ID=

# LSEG client credentials, exchanged for a bearer token. The key is the service-account id:
# a short id, not a UUID. The secret is that account's password, and that one is a UUID.
# A separate API-key UUID, and a product key, are not this pair.
UPSTREAM_API_KEY=
UPSTREAM_API_SECRET=
UPSTREAM_API_URL=https://api.risk.lseg.com/screening/v3
UPSTREAM_TOKEN_URL=https://api.risk.lseg.com/auth/oauth2/v1/token
UPSTREAM_TIMEOUT_SECONDS=30
# UPSTREAM_RETRY_MAX_ATTEMPTS=5
# UPSTREAM_RETRY_MAX_WAIT_SECONDS=30

REDIS_URL=redis://localhost:6379/0

# Tracing is opt-in, e.g. OTEL_TRACES_EXPORTER=console locally or otlp with
# OTEL_EXPORTER_OTLP_ENDPOINT in a cluster.
# OTEL_TRACES_EXPORTER=
