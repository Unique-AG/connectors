# mcp-scaffold-commit: 6474bb8667dc, timestamp: 2026-11-16T10:36:30+00:00
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
# disclose prints identifying values in logs instead of their sha256. Local debugging only.
LOGS_DIAGNOSTICS_DATA_POLICY=conceal
# Public origin, without the MCP path. Defaults to http://HOST:PORT.
# MCP_BASE_URL=http://127.0.0.1:8000
# JSON list of browser origins allowed to call the MCP endpoint.
# MCP_ALLOWED_ORIGINS=["http://localhost:6274"]

# none serves without sign-in, on loopback only. zitadel is what a deployment uses.
MCP_AUTH_MODE=none
# ZITADEL_BASE_URL=https://zitadel.example.com
# ZITADEL_CLIENT_ID=
# Leave unset for a public client with PKCE.
# ZITADEL_CLIENT_SECRET=
# At least 32 characters. Signs the tokens the MCP issues and encrypts them in Postgres.
# ZITADEL_JWT_SIGNING_KEY=
# Restricts sign-in to one organisation. The Zitadel app must put the user's organisation
# (urn:zitadel:iam:user:resourceowner:id) in the id token, or every sign-in is refused.
# ZITADEL_ORG_ID=

# One Kyckr key per deployment, shared by every signed-in user. Never stored in the database.
UPSTREAM_API_KEY=
# The test API. Production is https://api.kyckr.com/v2.
UPSTREAM_API_URL=https://test-api.kyckr.com/v2
UPSTREAM_TIMEOUT_SECONDS=30
# Optional, sent to Kyckr for usage reconciliation and for the contact on a document order.
# UPSTREAM_DEFAULT_CUSTOMER_REFERENCE=
# UPSTREAM_DEFAULT_CONTACT_EMAIL=
# UPSTREAM_RETRY_MAX_ATTEMPTS=5
# UPSTREAM_RETRY_MAX_WAIT_SECONDS=30
# UPSTREAM_RETRY_STATUSES=[429]

# The chart sets DATABASE_URL, PG_DATABASE_SSL_MODE and DB_SSL_ROOT_CERT. Only zitadel sign-in
# connects, so MCP_AUTH_MODE=none runs without a database.
DATABASE_URL=postgresql://dummy-user:dummy-password@localhost:5432/kyckr_mcp

# Tracing is opt-in, e.g. OTEL_TRACES_EXPORTER=console locally or otlp with
# OTEL_EXPORTER_OTLP_ENDPOINT in a cluster.
# OTEL_TRACES_EXPORTER=
