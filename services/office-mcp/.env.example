# Application environment: development | production | test
APP_ENV=development

# Port the HTTP server listens on
PORT=9544

# Log level: critical | error | warning | info | debug
LOG_LEVEL=info

# The externally-reachable URL of this service — used as the OAuth issuer/base URL once auth
# lands. With APP_ENV=production a loopback or 0.0.0.0 URL is rejected at startup: left at the
# local default, clients would be redirected to a login form on their own machine and simply
# fail to connect.
PUBLIC_BASE_URL=http://localhost:9544

# Database - either DB_URL / DATABASE_URL or all individual settings.
# DATABASE_URL is also accepted (injected by the base Helm chart when postgresql.enabled).
# A plain postgresql:// URL is what asyncpg wants. A postgresql+asyncpg:// or postgres:// URL
# is accepted and normalised: sslmode=verify becomes verify-full, channel_binding is dropped.
# DB_URL=postgresql://postgres:postgres@localhost:9001/office_mcp
DB_HOST=localhost
DB_PORT=9001
DB_NAME=office_mcp
DB_USER=postgres
DB_PASSWORD=postgres

# Tracing, off unless one of these is set — `configure_tracing` installs no tracer provider without
# them and every span in the process stays a no-op. All commented out on purpose: a developer who
# wants traces opts in, and a test run must not.
# OTEL_SERVICE_NAME and OTEL_SERVICE_VERSION are absent because create_app passes both explicitly.
#
# Print spans to stderr, which needs no collector:
# OTEL_TRACES_EXPORTER=console
#
# Or send them to a collector. Either endpoint turns tracing on by itself, so OTEL_TRACES_EXPORTER
# need not also be set; the traces-specific one wins where both are, and is taken verbatim, while
# the generic one gets "/v1/traces" appended. The exporter speaks OTLP over HTTP, hence 4318.
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
#
# Which environment the spans came from. Nothing else sets it: configure_tracing writes service.name
# and service.version and stops there.
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment=development
