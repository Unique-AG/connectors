# Application environment: development | production | test
APP_ENV=development

# Port the HTTP server listens on
PORT=9544

# Log level: critical | error | warning | info | debug
LOG_LEVEL=info

# The externally-reachable URL of this service — the OAuth issuer/base URL. With
# APP_ENV=production a loopback or 0.0.0.0 URL is rejected at startup: left at the local default,
# clients would be redirected to a login form on their own machine and simply fail to connect.
# The Entra app registration must list "$PUBLIC_BASE_URL/auth/callback" as a Web redirect URI.
PUBLIC_BASE_URL=http://localhost:9544

# The Entra app registration users sign in through. All three are required — the service does not
# start without them. TENANT_ID must be a single tenant's ID: "common"/"organizations" are
# rejected, because every token would then fail issuer validation.
# The app registration must also expose an API with the scope "access_as_user" (see README).
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# Database - either DB_URL / DATABASE_URL or all individual settings.
# DATABASE_URL is also accepted (injected by the base Helm chart when postgresql.enabled).
# A plain postgresql:// URL is what asyncpg wants. A postgresql+asyncpg:// or postgres:// URL
# is accepted and normalised: sslmode=verify becomes verify-full, channel_binding is dropped.
# DB_URL=postgresql://postgres:postgres@localhost:9001/office_mcp
DB_HOST=localhost
DB_PORT=9001
DB_NAME=office_mcp
DB_USER=postgres
DB_PASSWORD=postgres
