# Application environment: development | production | test
APP_ENV=development

# Port the HTTP server listens on
PORT=9544

# Log level: critical | error | warning | info | debug
LOG_LEVEL=info

# The externally-reachable URL of this service — used as the OAuth issuer/base URL once auth
# lands. With APP_ENV=production a loopback or 0.0.0.0 URL is rejected at startup: left at the
# local default, clients would be redirected to a login form on their own machine and simply
# fail to connect.
PUBLIC_BASE_URL=http://localhost:9544

# Database - either DB_URL / DATABASE_URL or all individual settings.
# DATABASE_URL is also accepted (injected by the base Helm chart when postgresql.enabled).
# A plain postgresql:// URL is what asyncpg wants. A postgresql+asyncpg:// or postgres:// URL
# is accepted and normalised: sslmode=verify becomes verify-full, channel_binding is dropped.
# DB_URL=postgresql://postgres:postgres@localhost:9001/office_mcp
DB_HOST=localhost
DB_PORT=9001
DB_NAME=office_mcp
DB_USER=postgres
DB_PASSWORD=postgres
