HOST=127.0.0.1
PORT=8741
PYTHON_ENV=development
# DEBUG, INFO, WARNING, ERROR or CRITICAL.
LOG_LEVEL=INFO
# Public origin, without /mcp. Defaults to http://HOST:PORT.
# MCP_BASE_URL=http://127.0.0.1:8741
# Explicit loopback-only bypass for local development.
MCP_AUTH_MODE=none
# Browser origins allowed to call /mcp, as a JSON list (default: the MCP Inspector in development, none otherwise).
# MCP_ALLOWED_ORIGINS=["http://localhost:6274"]

# Set MCP_AUTH_MODE=zitadel to exercise OAuth locally.
ZITADEL_ISSUER_URL=
# Public Zitadel client (PKCE), so there is no client secret.
ZITADEL_CLIENT_ID=
# Optional restriction to members of one organization:
# ZITADEL_ORG_ID=
# Required with zitadel auth; generate with: openssl rand -hex 32
MCP_JWT_SIGNING_KEY=

# Set the Tiingo API token in this ignored local file.
TIINGO_API_KEY=
