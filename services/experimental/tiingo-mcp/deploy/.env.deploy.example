# Copy the Azure values from another service's .env.deploy.example in the product repository.
SUBSCRIPTION_ID=
RESOURCE_GROUP=
LOCATION=
CONTAINER_APP_ENV=tiingo-mcp-env
CONTAINER_APP_NAME=tiingo-mcp

# Used by the in-process FastMCP OIDC proxy. Create the Zitadel Web Application
# with the callback https://<container-app-fqdn>/auth/callback, then fill these
# values and run ./configure-auth.sh tiingo-mcp from the repository root.
ZITADEL_ISSUER_URL=
ZITADEL_CLIENT_ID=
ZITADEL_CLIENT_SECRET=
ZITADEL_TOKEN_ENDPOINT_AUTH_METHOD=client_secret_post
# ZITADEL_ORG_ID=
# Generate once and keep stable across redeployments and replicas:
# openssl rand -hex 32
MCP_JWT_SIGNING_KEY=
