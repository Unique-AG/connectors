# Copy to .env in this directory. Do not commit .env.
# Used by explore.py (API token) and docs.py (web password). Never print these values.

# REST API — GET only. Point this at the client-obtained tenant. Do not commit a real host.
BACKSTOP_BASE_URL=https://api.backstopsolutions.com
BACKSTOP_SERVICE_USERNAME=
BACKSTOP_SERVICE_API_TOKEN=

# Elevio help center — web login on help-prod, not the API token.
# If these are missing, ask the user before running docs.py.
BACKSTOP_DOCS_USERNAME=
BACKSTOP_DOCS_PASSWORD=

# Question-set harness (test_set.py). Local Cursor agent + local backstop-mcp.
# Start the server first: uv run backstop-mcp
# cursor-sdk is not a locked service dep: uv pip install cursor-sdk==1.0.31
# test_set.py logs in with BACKSTOP_SERVICE_USERNAME / BACKSTOP_SERVICE_API_TOKEN above.
# CURSOR_API_KEY=   # https://cursor.com/dashboard/api
# BACKSTOP_MCP_URL=http://localhost:9010/mcp
# 1Password CLI (`op signin`). The item body is JSON:
#   {"cases":[{"id":"A1","question":"...","expected":"..."}]}
# OP_ACCOUNT=unique-team.1password.com
# OP_TEST_SET=op://Vault/Item/notesPlain
