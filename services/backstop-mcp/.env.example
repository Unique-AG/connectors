# Application environment: development | production | test
APP_ENV=development

# Port the HTTP server listens on
PORT=9010

# Log level: critical | error | warning | info | debug
LOG_LEVEL=info

# The externally-reachable URL of this service — used as the OAuth issuer/base URL for
# discovery metadata, /authorize, /token, and the Backstop login form. With APP_ENV=production
# a loopback or 0.0.0.0 URL is rejected at startup: left at the local default, clients would be
# redirected to a login form on their own machine and simply fail to connect.
PUBLIC_BASE_URL=http://localhost:9010

# Backstop REST API base URL
BACKSTOP_BASE_URL=https://api.backstopsolutions.com

# In-memory catalog caches, one flag per feature. A catalog is a small
# instance-wide `{id: dto}` map (custom-field definitions and groups, activity tags, system users)
# that many tool calls read and nothing writes. With a flag off, every read re-walks Backstop.
#
# Custom-field catalogs default on (3,274 definitions, 2.77 MiB, 6.15 s measured). Activity tags
# and system users stay off until their histograms justify the staleness; see
# src/backstop_mcp/features/cached_catalog.py.
# BACKSTOP_CUSTOM_FIELD_SCHEMA_CACHE_ENABLED=true
# BACKSTOP_ACTIVITY_TAG_CACHE_ENABLED=false
# BACKSTOP_SYSTEM_USER_CACHE_ENABLED=false

# How long an enabled catalog cache holds before it is re-fetched. Ignored while the matching
# flag above is false. Custom-field TTL defaults to 120 minutes; activity tags and system users
# default to 24 hours (1440). All three are capped at 24 hours. Values above the cap (including
# the previous 10080 example) are clamped so existing deploys still boot.
# `list_custom_fields(refresh=true)` and `list_activity_tags(refresh=true)` force a refetch when
# something is missing, whatever the TTL says.
#
# The custom-field TTL covers both that feature's catalogs: definitions and groups.
# BACKSTOP_CUSTOM_FIELD_SCHEMA_TTL_MINUTES=120
# BACKSTOP_ACTIVITY_TAG_TTL_MINUTES=1440
# BACKSTOP_SYSTEM_USER_TTL_MINUTES=1440

# How long a fetched opportunity-stage vocabulary (GET /opportunity-stages, 7 rows) stays usable
# before it is re-fetched. It names the stages in a deal's history that the opportunities response
# does not side-load. Default is 60 minutes; maximum is 24 hours (1440). No cache flag pairs with
# this one: seven rows in one page is cheap enough that it is always held, and it does not go
# through the catalog protocol above.
# BACKSTOP_OPPORTUNITY_STAGE_TTL_MINUTES=60

# No *per-user* Backstop credentials are configured as static env vars: each MCP client goes
# through this server's own OAuth login (a form collecting a Backstop username + personal API
# token — see src/backstop_mcp/features/auth/provider.py), and the resulting credential is stored
# encrypted per-user rather than shared across all callers.

# Which entity-relationship types mean employment, and which of those mean it has ended, for
# departed-contact detection. Comma-separated. Ids match a type id exactly; markers match
# case-insensitively as substrings of the type's name. Setting a MARKERS var replaces its
# defaults (empty value = ids only for that bucket).
#
# The FORMER half does the detecting: tenants model a departure as a separate relationship type
# ("is a former employee of" alongside "is employee of") and rarely fill in endDate. So the two
# marker lists must not overlap — "employee" matches both type names, "former" only one.
#
# List the instance's own types with:
#   GET /entity-relationship-types
# and configure the FORMER ids from it — exact ids beat markers, but they differ per instance.
#
# An organization's own GET returns the *mirror* of these types ("is employee of (mirror)",
# "is a former employee of (mirror)") — same names plus the suffix, but different ids. Name
# markers already match both directions on their own; exact FORMER ids do not, so list the
# mirror type's id too if this deployment configures ids rather than markers.
# BACKSTOP_EMPLOYMENT_RELATIONSHIP_TYPE_IDS=
# BACKSTOP_EMPLOYMENT_RELATIONSHIP_TYPE_MARKERS=employ
# BACKSTOP_FORMER_EMPLOYMENT_RELATIONSHIP_TYPE_IDS=
# BACKSTOP_FORMER_EMPLOYMENT_RELATIONSHIP_TYPE_MARKERS=former,previous,ex-,no longer

# Per-stream page size for the activity-history tools (meetings/calls/notes/documents + email).
# Each active stream (up to five) is fetched at this same page size, and the merge step across
# streams is not itself capped — a page can therefore return up to PAGE_SIZE * active-stream-count
# records. A deliberate simplification, not a hard limit on total output per page.
# ACTIVITY_HISTORY_PAGE_SIZE=10

# Character budget each activity/email record's HTML body is truncated to when converted to a
# Markdown "gist" (see features/activity_history/extract_gist_from_html.py). Note a gist is not a
# summary — the first ~300 chars of a meeting note are usually its attendee table.
# ACTIVITY_HISTORY_GIST_CHARS=300

# How long a tool waits for the user to pick between ambiguous matches (e.g. the several
# organizations named "Mercer") before giving up on the prompt and returning the candidate list
# for the model to ask about instead. See features/resolution.py.
#
# This must stay UNDER the calling client's tool-call deadline, and the margin has to cover the
# upstream search that runs before the prompt. The Unique chat client cancels at 60s: when the
# prompt outlived that, the call was cancelled, the candidates already fetched were thrown away,
# and the user got nothing after a full minute — which is what this knob exists to prevent.
# Lower it for a client with a tighter deadline.
# RESOLUTION_ELICIT_TIMEOUT_SECONDS=45

# Database - either DB_URL / DATABASE_URL or all individual settings.
# DATABASE_URL is also accepted (injected by the base Helm chart when postgresql.enabled).
# A plain "postgresql://" URL works too — DatabaseConfig rewrites it to
# "postgresql+asyncpg://" automatically, so you don't need to add the driver yourself.
# DB_URL=postgresql://postgres:postgres@localhost:9001/backstop_mcp
DB_HOST=localhost
DB_PORT=9001
DB_NAME=backstop_mcp
DB_USER=postgres
DB_PASSWORD=postgres

# How long a fully-expired OAuth token family is kept before the background sweep deletes it.
# The rows are an audit trail of one grant's refresh rotations, so they outlive their usefulness
# as credentials. Lower it to shrink the table; raise it to keep more history.
# AUTH_TOKEN_RETENTION_DAYS=30

# How long a registered OAuth client with nothing left referencing it is kept. Client registration
# is open (RFC 7591), so every client that ever connected — and anyone who merely called /register
# — leaves a row behind. A client in use always holds a live token family and is never swept; this
# only bounds registration spam and clients that registered but never finished a login.
# AUTH_UNUSED_CLIENT_RETENTION_HOURS=24

# How often that sweep runs. Expired rows are never accepted regardless, so this only bounds how
# long dead rows linger.
# AUTH_CLEANUP_INTERVAL_HOURS=6

# Failed-login throttling for the hosted Backstop login form. Anyone who can start an OAuth flow
# can POST credentials to /backstop/login, which forwards them to Backstop — so without a limit
# that endpoint is a credential-testing oracle. Counted per Backstop username (not per source IP:
# behind an ingress every caller shares one address, and X-Forwarded-For is client-spoofable).
# A successful login clears the username's count.
# AUTH_LOGIN_MAX_ATTEMPTS=10
# AUTH_LOGIN_ATTEMPT_WINDOW_MINUTES=15

# Fernet key used to encrypt stored Backstop credentials.
# Generate one locally with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BACKSTOP_MCP_ENCRYPTION_KEY=
