# Application environment: development | production | test
APP_ENV=development

# Port the HTTP server listens on
PORT=9010

# Log level: fatal | error | warn | info | debug
LOG_LEVEL=info

# The externally-reachable URL of this service — used as the OAuth issuer/base URL for
# discovery metadata, /authorize, /token, and the Backstop login form. Must be the real
# public URL in any deployed environment (not localhost).
PUBLIC_BASE_URL=http://localhost:9010

# Backstop REST API base URL
BACKSTOP_BASE_URL=https://api.backstopsolutions.com

# Optional JSON map of human overlays for weird CRM custom-field names, e.g.:
# BACKSTOP_CUSTOM_FIELD_OVERRIDES={"organizations:is1":{"display_name":"Investor Status","aliases":["investor status"]}}
# Keys are entityType:crmName. See custom_fields/overrides.py.
# BACKSTOP_CUSTOM_FIELD_OVERRIDES=

# No *per-user* Backstop credentials are configured as static env vars: each MCP client goes
# through this server's own OAuth login (a form collecting a Backstop username + personal API
# token — see src/backstop_mcp/auth/provider.py), and the resulting credential is stored
# encrypted per-user rather than shared across all callers.

# How long a fetched custom-field schema snapshot stays usable before it is re-fetched from
# Backstop. Definitions change rarely (a CRM admin adding a field), so the default is one week.
# BACKSTOP_CUSTOM_FIELD_SCHEMA_TTL_MINUTES=10080

# Optional service account, used ONLY to warm the custom-field schema cache at startup so the
# first user's tools/list already carries the field glossary. Leave both unset and the schema
# is fetched lazily by the first authenticated caller instead — everything still works, the
# very first listing just has no glossary. Must be set together or startup fails.
# This token can read instance-wide custom-field metadata; treat it as a shared secret.
# BACKSTOP_SERVICE_USERNAME=
# BACKSTOP_SERVICE_API_TOKEN=

# Database - either DB_URL / DATABASE_URL or all individual settings.
# DATABASE_URL is also accepted (injected by the base Helm chart when postgresql.enabled).
# A plain "postgresql://" URL works too — DatabaseConfig rewrites it to
# "postgresql+asyncpg://" automatically, so you don't need to add the driver yourself.
# DB_URL=postgresql://postgres:postgres@localhost:9001/backstop_mcp
DB_HOST=localhost
DB_PORT=9001
DB_NAME=backstop_mcp
DB_USER=postgres
DB_PASSWORD=postgres

# 32-byte AES-256 key (base64-encoded) used to encrypt stored Backstop credentials.
# Generate one locally with: python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
BACKSTOP_MCP_ENCRYPTION_KEY=
