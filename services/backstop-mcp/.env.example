# Application environment: development | production | test
APP_ENV=development

# Port the HTTP server listens on
PORT=8000

# Log level: fatal | error | warn | info | debug
LOG_LEVEL=info

# Backstop REST API base URL
BACKSTOP_BASE_URL=https://api.backstopsolutions.com

# No Backstop credentials are configured here: each MCP client authenticates as
# themselves by sending their own 'Authorization: Basic <base64(username:password)>'
# header (and, for SSO users authenticating with an API token, a 'token: true' header)
# when connecting to this server. See src/backstop_mcp/backstop_client.py.
