{
  "name": "@unique-ag/temenos-mcp",
  "description": "Temenos DataHub MCP Server — exposes ODS operational data as MCP tools",
  "version": "0.1.0",
  "author": "",
  "private": true,
  "license": "Unique License v1",
  "files": [
    "dist",
    "deploy"
  ],
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "debug": "nest start --debug",
    "codegen": "echo \"No codegen for this server\"",
    "style": "biome check .",
    "style:fix": "biome check . --write",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:e2e:watch": "vitest watch --config vitest.e2e.config.ts",
    "test:coverage": "vitest run --config vitest.coverage.config.ts && istanbul-badges-readme --style='square-flat'"
  },
  "dependencies": {
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@nestjs/swagger": "catalog:",
    "@opentelemetry/api": "catalog:",
    "@proventuslabs/nestjs-zod": "catalog:",
    "@unique-ag/instrumentation": "workspace:*",
    "@unique-ag/logger": "workspace:*",
    "@unique-ag/mcp-server-module": "workspace:*",
    "@unique-ag/probe": "workspace:*",
    "@unique-ag/utils": "workspace:*",
    "nestjs-otel": "catalog:",
    "nestjs-pino": "catalog:",
    "nestjs-zod": "catalog:",
    "pino": "catalog:",
    "pino-http": "catalog:",
    "reflect-metadata": "catalog:",
    "remeda": "catalog:",
    "rxjs": "catalog:",
    "typeid-js": "catalog:",
    "undici": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/cli": "catalog:",
    "@nestjs/schematics": "catalog:",
    "@nestjs/testing": "catalog:",
    "@suites/di.nestjs": "catalog:",
    "@suites/doubles.vitest": "catalog:",
    "@suites/unit": "catalog:",
    "@swc/cli": "catalog:",
    "@swc/core": "catalog:",
    "@types/node": "catalog:",
    "@types/supertest": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "istanbul-badges-readme": "catalog:",
    "supertest": "catalog:",
    "typescript": "catalog:",
    "unplugin-swc": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@10.34.5"
}
