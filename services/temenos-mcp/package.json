{
  "name": "@unique-ag/temenos-mcp",
  "description": "Temenos DataHub MCP Server — exposes ODS operational data as MCP tools",
  "version": "0.1.0",
  "author": "",
  "private": true,
  "license": "Unique License v1",
  "files": [
    "dist",
    "deploy"
  ],
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "debug": "nest start --debug",
    "codegen": "echo \"No codegen for this server\"",
    "style": "biome check .",
    "style:fix": "biome check . --write",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:e2e:watch": "vitest watch --config vitest.e2e.config.ts",
    "test:coverage": "vitest run --config vitest.coverage.config.ts && istanbul-badges-readme --style='square-flat'"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@nestjs/common": "12.0.1",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "@opentelemetry/api": "1.9.1",
    "@proventuslabs/nestjs-zod": "2.0.0",
    "@unique-ag/instrumentation": "workspace:*",
    "@unique-ag/logger": "workspace:*",
    "@unique-ag/mcp-server-module": "workspace:*",
    "@unique-ag/probe": "workspace:*",
    "@unique-ag/utils": "workspace:*",
    "express": "5.2.1",
    "nestjs-otel": "8.1.0",
    "nestjs-pino": "5.0.0",
    "nestjs-zod": "5.0.1",
    "reflect-metadata": "0.2.2",
    "remeda": "2.45.0",
    "rxjs": "7.8.2",
    "typeid-js": "1.2.0",
    "undici": "8.10.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.0",
    "@nestjs/schematics": "12.0.0",
    "@nestjs/testing": "12.0.1",
    "@suites/di.nestjs": "3.1.0",
    "@suites/doubles.vitest": "3.1.0",
    "@suites/unit": "3.1.1",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.16.1",
    "@types/express": "5.0.6",
    "@types/node": "26.4.0",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-istanbul": "4.1.11",
    "globals": "17.11.0",
    "istanbul-badges-readme": "1.9.0",
    "source-map-support": "0.5.21",
    "supertest": "7.2.2",
    "type-fest": "5.8.0",
    "typescript": "7.0.2",
    "unplugin-swc": "1.5.11",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@10.34.5"
}
