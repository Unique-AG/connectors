{
  "name": "@unique-ag/unique-api",
  "description": "Shared NestJS module for Unique platform API integration",
  "version": "0.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "src/index.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "format": "biome format .",
    "format:fix": "biome format . --write",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@proventuslabs/nestjs-zod": "2.0.0",
    "@unique-ag/utils": "workspace:*",
    "bottleneck": "2.19.5",
    "graphql": "16.14.2",
    "graphql-request": "7.4.0",
    "remeda": "2.45.0",
    "undici": "7.29.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nestjs/common": "11.2.3",
    "@nestjs/core": "11.2.3",
    "@nestjs/terminus": "11.1.1",
    "@nestjs/testing": "11.2.3",
    "@opentelemetry/api": "1.9.1",
    "@suites/di.nestjs": "3.1.0",
    "@suites/doubles.vitest": "3.1.0",
    "@suites/unit": "3.1.1",
    "@swc/core": "1.16.1",
    "@types/node": "26.4.0",
    "nestjs-otel": "8.1.0",
    "reflect-metadata": "0.2.2",
    "typescript": "5.9.3",
    "unplugin-swc": "1.5.11",
    "vitest": "3.2.7"
  },
  "peerDependencies": {
    "@nestjs/common": "^11",
    "@nestjs/core": "^11",
    "@nestjs/terminus": "^11",
    "@opentelemetry/api": "^1.9.0",
    "nestjs-otel": "^8"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  }
}
