{
  "name": "@unique-ag/unique-api",
  "description": "Shared NestJS module for Unique platform API integration",
  "version": "0.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "src/index.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "format": "biome format .",
    "format:fix": "biome format . --write",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@proventuslabs/nestjs-zod": "catalog:",
    "@unique-ag/utils": "workspace:*",
    "bottleneck": "catalog:",
    "graphql": "catalog:",
    "graphql-request": "catalog:",
    "remeda": "catalog:",
    "undici": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/common": "catalog:",
    "@nestjs/terminus": "catalog:",
    "@opentelemetry/api": "catalog:",
    "@swc/core": "catalog:",
    "@types/node": "catalog:",
    "reflect-metadata": "catalog:",
    "typescript": "catalog:",
    "unplugin-swc": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@nestjs/common": "^11",
    "@nestjs/terminus": "^11",
    "@opentelemetry/api": "^1.9.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  }
}
