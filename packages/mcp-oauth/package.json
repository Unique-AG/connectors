{
  "name": "@unique-ag/mcp-oauth",
  "description": "Modular authentication module for MCP servers with OAuth 2.1",
  "version": "0.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "src/index.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:e2e:watch": "vitest watch --config vitest.e2e.config.ts",
    "test:coverage": "vitest run --config vitest.coverage.config.ts && istanbul-badges-readme --style='square-flat'",
    "style": "biome check .",
    "style:fix": "biome check . --write",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "catalog:",
    "@nestjs/schedule": "catalog:",
    "@nestjs/throttler": "6.5.0",
    "bcrypt": "6.0.0",
    "nestjs-zod": "catalog:",
    "reflect-metadata": "catalog:",
    "serialize-error-cjs": "catalog:",
    "typeid-js": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/testing": "catalog:",
    "@opentelemetry/api": "catalog:",
    "@suites/di.nestjs": "catalog:",
    "@suites/doubles.vitest": "catalog:",
    "@suites/unit": "catalog:",
    "@swc/core": "catalog:",
    "@types/bcrypt": "6.0.0",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "@types/passport": "1.0.17",
    "@types/supertest": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "istanbul-badges-readme": "catalog:",
    "nestjs-otel": "catalog:",
    "passport": "catalog:",
    "rxjs": "catalog:",
    "supertest": "catalog:",
    "typescript": "catalog:",
    "unplugin-swc": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@nestjs/common": "^11",
    "@nestjs/core": "^11",
    "@opentelemetry/api": "^1.9.0",
    "nestjs-otel": "^8",
    "passport": "^0.7",
    "rxjs": "^7"
  }
}
