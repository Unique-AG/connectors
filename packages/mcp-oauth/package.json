{
  "name": "@unique-ag/mcp-oauth",
  "description": "Modular authentication module for MCP servers with OAuth 2.1",
  "version": "0.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "src/index.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:e2e:watch": "vitest watch --config vitest.e2e.config.ts",
    "test:coverage": "vitest run --config vitest.coverage.config.ts && istanbul-badges-readme --style='square-flat'",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "format": "biome format .",
    "format:fix": "biome format . --write",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/schedule": "12.0.1",
    "@nestjs/throttler": "6.5.0",
    "bcrypt": "6.0.0",
    "jsonwebtoken": "9.0.3",
    "nestjs-zod": "5.0.1",
    "reflect-metadata": "0.2.2",
    "serialize-error-cjs": "0.2.0",
    "typeid-js": "1.2.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/testing": "12.0.1",
    "@suites/di.nestjs": "3.1.0",
    "@suites/doubles.vitest": "3.1.0",
    "@suites/unit": "3.1.1",
    "@swc/core": "1.16.1",
    "@types/bcrypt": "6.0.0",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "26.4.0",
    "@types/passport": "1.0.17",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-istanbul": "4.1.11",
    "istanbul-badges-readme": "1.9.0",
    "supertest": "7.2.2",
    "typescript": "7.0.2",
    "unplugin-swc": "1.5.11",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "@nestjs/common": "^11",
    "@nestjs/core": "^11",
    "@opentelemetry/api": "^1.9.0",
    "nestjs-otel": "^8",
    "passport": "^0.7"
  }
}
