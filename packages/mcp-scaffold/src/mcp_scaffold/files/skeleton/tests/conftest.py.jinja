{% set postgres = "postgres" in options.persistence %}
{% set redis = "redis" in options.persistence %}
{% set parameters = [
    options.opens_upstream and "upstream_settings: UpstreamSettings",
    options.opens_persistence and "persistence_settings: PersistenceSettings",
    options.opens_upstream and "upstream_transport: httpx2.MockTransport",
] | select | join(", ") %}
{% set arguments = [
    options.opens_upstream and "upstream_settings",
    options.opens_persistence and "persistence_settings",
    options.opens_upstream and "upstream_transport",
] | select | list %}
{% if options.opens_upstream %}
import httpx2
{% endif %}
import pytest
from fastmcp import FastMCP
from mcp_runtime import ServerSettings
{% if arguments %}
from pydantic import SecretStr
{% endif %}

from mcp_skeleton.mcp import create_server
{% if options.opens_persistence %}
from mcp_skeleton.persistence import {{ [postgres and "DatabaseSettings", "PersistenceSettings", redis and "StoreSettings"] | select | join(", ") }}
{% endif %}
{% if options.opens_upstream %}
from mcp_skeleton.upstream import UpstreamSettings
{% endif %}

{% if postgres %}
TEST_DATABASE_URL = SecretStr("postgresql://dummy-user:dummy-password@localhost:5432/test")
{% endif %}
{% if redis %}
TEST_STORE_URL = SecretStr("redis://localhost:6379/0")
{% endif %}


@pytest.fixture
def server_settings() -> ServerSettings:
    return ServerSettings(_env_file=None)  # pyright: ignore[reportCallIssue]
{% if options.opens_upstream %}


@pytest.fixture
def upstream_settings() -> UpstreamSettings:
    return UpstreamSettings(api_key=SecretStr("dummy-api-key"), _env_file=None)  # pyright: ignore[reportCallIssue]


@pytest.fixture
def upstream_transport() -> httpx2.MockTransport:
    """Stands in for the upstream.

    Answer each route with fixed data, as FakeCatalog does in services/architecture-demo-mcp.
    """
    return httpx2.MockTransport(lambda _request: httpx2.Response(404))
{% endif %}
{% if options.opens_persistence %}


@pytest.fixture
def persistence_settings() -> PersistenceSettings:
{% if postgres %}
    database = DatabaseSettings(url=TEST_DATABASE_URL, _env_file=None)  # pyright: ignore[reportCallIssue]
{% endif %}
{% if redis %}
    store = StoreSettings(url=TEST_STORE_URL, _env_file=None)  # pyright: ignore[reportCallIssue]
{% endif %}
    return PersistenceSettings({{ [postgres and "database=database", redis and "store=store"] | select | join(", ") }})
{% endif %}


@pytest.fixture
def server({{ parameters }}) -> FastMCP:
    return create_server({{ arguments | join(", ") }})
