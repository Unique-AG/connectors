{% if not (options.opens_persistence or options.opens_upstream) %}
"""A `Depends` provider per resource the server lifespan yields."""
{% else %}
from typing import cast

from fastmcp.dependencies import CurrentContext
from fastmcp.server.context import Context

{% if options.opens_persistence %}
from mcp_skeleton.persistence import Persistence
{% endif %}
{% if options.auth %}
from mcp_skeleton.mcp.auth import caller_credentials
{% endif %}
{% if options.auth %}
from mcp_skeleton.shared import CredentialsProvider
{% endif %}
{% if options.opens_upstream %}
from mcp_skeleton.upstream import Upstream
{% endif %}
{% if options.opens_persistence %}


def get_persistence(ctx: Context = CurrentContext()) -> Persistence:
    return cast(Persistence, ctx.lifespan_context["persistence"])
{% endif %}
{% if options.opens_upstream %}


def get_upstream(ctx: Context = CurrentContext()) -> Upstream:
    return cast(Upstream, ctx.lifespan_context["upstream"])
{% endif %}
{% if options.auth %}


def get_credentials(ctx: Context = CurrentContext()) -> CredentialsProvider:
    """The credentials of the user the call acts for. `Upstream` signs every request with them
    already; this is for a request that takes them in place of the client's own."""
    return caller_credentials(lambda: get_persistence(ctx).auth)
{% endif %}
{% endif %}
