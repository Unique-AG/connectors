{% set settings = [
    options.opens_upstream and "from_environment(UpstreamSettings)",
    options.opens_persistence and "persistence",
] | select | join(", ") %}
{% if options.opens_persistence %}
from functools import partial

{% endif %}
{% if options.opens_upstream %}
from mcp_configs import LoggingSettings, ServerSettings, from_environment
{% else %}
from mcp_configs import LoggingSettings, ServerSettings
{% endif %}

from mcp_skeleton.mcp import create_server, run_server
{% if options.opens_persistence %}
from mcp_skeleton.persistence import PersistenceSettings, open_persistence
{% endif %}
from mcp_skeleton.telemetry import init_telemetry
{% if options.opens_upstream %}
from mcp_skeleton.upstream import UpstreamSettings
{% endif %}


def main() -> None:
    init_telemetry(LoggingSettings())
{% if options.opens_persistence %}
    persistence = partial(open_persistence, PersistenceSettings())
{% endif %}
    server = create_server({{ settings }})
    run_server(server, ServerSettings())


if __name__ == "__main__":
    main()
