HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
# disclose prints identifying values in logs instead of their sha256. Local debugging only.
LOGS_DIAGNOSTICS_DATA_POLICY=conceal
# Public origin, without the MCP path. Defaults to http://HOST:PORT.
# MCP_BASE_URL=http://127.0.0.1:8000
# JSON list of browser origins allowed to call the MCP endpoint.
# MCP_ALLOWED_ORIGINS=["http://localhost:6274"]
{% if options.auth %}

# Users sign in at MCP_BASE_URL/sign-in with their own credentials for the upstream, which are
# kept encrypted with this Fernet key. Generate one with
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MCP_AUTH_ENCRYPTION_KEY=
# MCP_AUTH_MAX_FAILED_SIGN_INS=10
# MCP_AUTH_FAILED_SIGN_IN_WINDOW_MINUTES=15
# MCP_AUTH_ACCESS_TOKEN_MINUTES=15
# MCP_AUTH_REFRESH_TOKEN_DAYS=30
{% endif %}
{% if options.opens_upstream %}

{% if options.auth %}
# A GET the upstream answers 401 or 403 to wrong credentials, which the sign-in checks them with.
UPSTREAM_VERIFY_PATH=/
{% else %}
UPSTREAM_API_KEY=
{% endif %}
UPSTREAM_API_URL={{ api_url }}
UPSTREAM_TIMEOUT_SECONDS=30
# UPSTREAM_RETRY_MAX_ATTEMPTS=5
# UPSTREAM_RETRY_MAX_WAIT_SECONDS=30
{% endif %}
{% if "postgres" in options.persistence %}

# The chart sets DATABASE_URL, PG_DATABASE_SSL_MODE and DB_SSL_ROOT_CERT.
DATABASE_URL=postgresql://dummy-user:dummy-password@localhost:5432/mcp_skeleton
{% endif %}
{% if "redis" in options.persistence %}

REDIS_URL=redis://localhost:6379/0
{% endif %}

# Tracing is opt-in, e.g. OTEL_TRACES_EXPORTER=console locally or otlp with
# OTEL_EXPORTER_OTLP_ENDPOINT in a cluster.
# OTEL_TRACES_EXPORTER=
