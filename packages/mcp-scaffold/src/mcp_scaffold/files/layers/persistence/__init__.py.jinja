{% set postgres = "postgres" in options.persistence %}
{% set redis = "redis" in options.persistence %}
{% set names = [
    postgres and "Base",
    postgres and "DatabaseSettings",
    "Persistence",
    "PersistenceSettings",
    redis and "StoreSettings",
    "open_persistence",
] | select | list %}
{% if postgres %}
from mcp_skeleton.persistence.database import DatabaseSettings
from mcp_skeleton.persistence.models import Base
{% endif %}
from mcp_skeleton.persistence.persistence import Persistence, PersistenceSettings, open_persistence
{% if redis %}
from mcp_skeleton.persistence.store import StoreSettings
{% endif %}

__all__ = {{ names | tojson }}
