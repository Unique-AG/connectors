import httpx2
{% if options.upstream == "openapi" %}
from mcp_openapi.upstream import UpstreamError
{% endif %}

{% if options.upstream == "custom" %}
from mcp_skeleton.upstream.client import UpstreamError
{% endif %}
from mcp_skeleton.shared import UpstreamCredentials
from mcp_skeleton.upstream.credentials import auth_for
from mcp_skeleton.upstream.settings import UpstreamSettings


async def verify_credentials(
    settings: UpstreamSettings,
    credentials: UpstreamCredentials,
    transport: httpx2.AsyncBaseTransport | None = None,
) -> bool:
    """Whether the upstream accepts `credentials`, asked at `settings.verify_path`.

    A 401 or 403 is a no. Any other error says nothing about the credentials, so it is an
    UpstreamError, and the user is asked to try again rather than told they are wrong.
    """
    async with httpx2.AsyncClient(
        base_url=str(settings.api_url).rstrip("/"),
        timeout=settings.timeout_seconds,
        transport=transport,
    ) as http:
        try:
            response = await http.get(settings.verify_path, auth=auth_for(credentials))
        except httpx2.HTTPError as error:
            raise UpstreamError(str(error) or type(error).__name__) from error
    if response.status_code in {401, 403}:
        return False
    if response.is_error:
        raise UpstreamError(
            f"{response.status_code} {response.reason_phrase} for GET {settings.verify_path}"
        )
    return True
