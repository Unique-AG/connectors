{
  "name": "@unique-ag/proxy",
  "description": "Shared NestJS module for outbound HTTP(S) proxy support",
  "version": "0.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "src/index.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "style": "biome check .",
    "style:fix": "biome check . --write",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@proventuslabs/nestjs-zod": "catalog:",
    "@unique-ag/utils": "workspace:*",
    "https-proxy-agent": "7.0.6",
    "remeda": "catalog:",
    "undici": "catalog:"
  },
  "devDependencies": {
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@swc/core": "catalog:",
    "@types/node": "catalog:",
    "typeid-js": "catalog:",
    "typescript": "catalog:",
    "unplugin-swc": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@nestjs/common": "^11",
    "@nestjs/config": "^4",
    "typeid-js": "^1.2.0",
    "zod": "^4.1.5"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  }
}
