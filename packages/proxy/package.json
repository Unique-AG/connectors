{
  "name": "@unique-ag/proxy",
  "description": "Shared NestJS module for outbound HTTP(S) proxy support",
  "version": "0.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "src/index.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "format": "biome format .",
    "format:fix": "biome format . --write",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@proventuslabs/nestjs-zod": "2.0.0",
    "@unique-ag/utils": "workspace:*",
    "https-proxy-agent": "9.1.0",
    "remeda": "2.45.0",
    "undici": "8.10.1"
  },
  "devDependencies": {
    "@nestjs/common": "12.0.1",
    "@nestjs/config": "12.0.0",
    "@swc/core": "1.16.1",
    "@types/node": "26.4.0",
    "typescript": "7.0.2",
    "unplugin-swc": "1.5.11",
    "vitest": "4.1.11",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@nestjs/common": "^11",
    "@nestjs/config": "^4",
    "zod": "^4.1.5"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  }
}
