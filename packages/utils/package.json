{
  "name": "@unique-ag/utils",
  "description": "Shared utility modules for the connectors monorepo",
  "version": "0.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "src/index.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "format": "biome format .",
    "format:fix": "biome format . --write",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "remeda": "2.45.0"
  },
  "devDependencies": {
    "@swc/core": "1.16.1",
    "@types/node": "26.4.0",
    "typeid-js": "1.2.0",
    "typescript": "7.0.2",
    "unplugin-swc": "1.5.11",
    "vitest": "4.1.11",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "typeid-js": "^1.2.0",
    "zod": "^4.1.5"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./zod": {
      "types": "./src/zod.ts",
      "import": "./src/zod.ts",
      "require": "./dist/zod.js",
      "default": "./dist/zod.js"
    }
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    },
    "typeid-js": {
      "optional": true
    }
  },
  "typesVersions": {
    "*": {
      "zod": [
        "./src/zod.ts"
      ]
    }
  }
}
