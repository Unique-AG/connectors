{
  "name": "@unique-ag/utils",
  "description": "Shared utility modules for the connectors monorepo",
  "version": "0.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "src/index.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "style": "biome check .",
    "style:fix": "biome check . --write",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "remeda": "catalog:"
  },
  "devDependencies": {
    "@swc/core": "catalog:",
    "@types/node": "catalog:",
    "typeid-js": "catalog:",
    "typescript": "catalog:",
    "unplugin-swc": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "typeid-js": "^1.2.0",
    "zod": "^4.1.5"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./zod": {
      "types": "./src/zod.ts",
      "import": "./src/zod.ts",
      "require": "./dist/zod.js",
      "default": "./dist/zod.js"
    }
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    },
    "typeid-js": {
      "optional": true
    }
  },
  "typesVersions": {
    "*": {
      "zod": [
        "./src/zod.ts"
      ]
    }
  }
}
