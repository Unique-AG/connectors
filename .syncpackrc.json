{
  "$schema": "./node_modules/syncpack/schema.json",
  "semverGroups": [
    {
      "label": "Enforce exact versions for all non-peer dependencies",
      "range": "",
      "packages": ["**"],
      "dependencyTypes": ["dev", "prod"]
    }
  ],
  "versionGroups": [
    {
      "label": "A2A gateway uses NestJS 12",
      "packages": ["@unique-ag/a2a-gateway"],
      "dependencies": [
        "@nestjs/cli",
        "@nestjs/common",
        "@nestjs/core",
        "@nestjs/platform-express",
        "@nestjs/schematics",
        "@nestjs/terminus",
        "@nestjs/testing",
        "typescript"
      ],
      "isIgnored": true
    },
    {
      "label": "Peer Dependencies - Allow range patterns",
      "packages": ["**"],
      "dependencyTypes": ["peer"],
      "policy": "sameRange"
    }
  ],
  "sortFirst": [
    "name",
    "description",
    "version",
    "author",
    "contributors",
    "private",
    "license",
    "main",
    "types",
    "module",
    "files",
    "type",
    "scripts",
    "dependencies",
    "devDependencies",
    "peerDependencies",
    "engines",
    "packageManager",
    "workspaces"
  ],
  "sortAz": [
    "bin",
    "keywords",
    "contributors",
    "dependencies",
    "devDependencies",
    "peerDependencies",
    "resolutions"
  ],
  "sortPackages": true
}
